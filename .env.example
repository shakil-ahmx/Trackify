# Copy to .env and change the values
POSTGRES_DB=trackify
POSTGRES_USER=trackify
POSTGRES_PASSWORD=change_me_strong_password

# Generate one:  openssl rand -base64 48
APP_JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars

# Port on your machine
WEB_PORT=3000
# Only needed if the browser origin differs from http://localhost:3000
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000
